# Server Port (default 3001)
PORT=3001

# Allowed CORS origins (default * allows all origins)
CLIENT_ORIGIN=*

# Code Execution Engine: 'judge0' (default) or 'piston'
EXECUTION_PROVIDER=judge0

# Judge0 Instance URL (default https://ce.judge0.com)
JUDGE0_URL=https://ce.judge0.com

# Optional API Key for Judge0 (if using RapidAPI or protected self-hosted instance)
# JUDGE0_API_KEY=

# Piston Instance URL (used if EXECUTION_PROVIDER=piston)
# PISTON_URL=https://emkc.org/api/v2/piston

# Yjs Persistence: set to 1 to enable LevelDB persistence for room documents
# PERSIST=1
# LEVELDB_DIR=./.leveldb
